import pandas as pd


info = {
    "Name" : ["Rahul", "Harshita", "Ankita"],
    "CGPA" : [9.5, 7.5, 8.5]
}
# To convert this information into pandas dataframe; a table is formed where the dictionary keys are headers of individual rows; 0,1,2 are labels assigned with each row automatically
df = pd.DataFrame(info)
print(df)


df


# Series
s = pd.Series([1, 2, 3, 4, 5])
print(s)
print(type(s))
# index
print(s[0])


# Custom labels
#s = pd.Series([23, 24, 25, 26, "abc"], index=["Adam", "Eve", "Bob", "Charlie", 25]) -> dtype = object on running
s = pd.Series([23, 24, 25, 26], index=["Adam", "Eve", "Bob", "Charlie"])
print(s)
print(s["Adam"]) # Label-based access
print(s[0]) # Index-based access
print(s.index) # To print all the index values - all labels will be printed


# Vectorized Operations
s1 = pd.Series([1, 2, 3, 4, 5])
s2 = pd.Series([10, 20, 30, 40, 50])
print(s1 + s2)
s1[0] = 100
print(s1) # Mutable Values
changed_s1 = s1.drop(0)
print(s1)
print(changed_s1)


# Create dictionary of lists to create a Data Frame
info = {
    "Name" : ["Adam", "Bob", "Eve"],
    "Age" : [23, 24, 25],
    "CGPA" : [9.5, 7.2, 8.6]
}
df = pd.DataFrame(info)
print(df, type(df))
print(df.index) # To print row labels, we get automatic index values
print(df.columns) # To print column labels


df


# List of lists to create DataFrame
df = pd.DataFrame([["Adam", 23], ["Bob", 24], ["Eve",25]], columns=["Name", "Age"])
print(df)


# Creating DataFrame from numpy arrays
import numpy as np
np_arr = ([[1, 2, 3], [4, 5, 6]])
df = pd.DataFrame(np_arr, columns=["A", "B", "C"])
print(df)


# To read csv data
df = pd.read_csv("employee_data.csv")
print(df, type(df))


# To read json data
df = pd.read_json("employee_data.json")
print(df, type(df))


# Methods
df.head() # Prints starting 5 rows data - By default we get 5 rows
df.tail(2) # Prints last 2 rows values
df.sample(3) # Random row is printed
df.info() # Gives random summary about data like no.of rows, cols
df.shape # Gives tuples(immutable value) of rows and cols
df.describe() # Gives important statistics of rows and cols
df.columns
df.nunique()


